# C. elegans single segment: reduced (V,w) system for XPPAUT/AUTO
# Generated by xppaut/generate_single_segment.py; do not edit by hand.
# Cells: 0-1 AS, 2 DA, 3 DB, 4 DD, 5-6 VD, 7-8 VB, 9-10 VA,
#        11-13 dorsal muscle, 14-16 ventral muscle.
# Connectivity convention is row=post, column=pre.

# AUTO-facing command parameters come first.
par iava=0,iavb=0
par gse=0.07,gsi=0.05,ggap=0.03
par ksyn=0.25,beta=1.03,tauw=400
par cap=7,gmem=1,ere=0,eri=-100
par vl=-70,vt=-45,vh=-35,vth=-52
par m1=0.7,m2=0.0123456790123,m3=-0.0333333333333,m4=0.17

# Piecewise Yuval membrane current, recovery target, and synaptic gate.
memb(v)=if(v>vh)then(m4*(-v+vh))else(if(v>=vt)then(m3*(v-vh)*(v-vt))else(if(v>=vl)then(m2*(v-vl)*(v-vt))else(m1*(-v+vl))))
winf(v)=if(v>vt)then(beta*(v-vt))else(0)
gate(v)=1/(1+exp(-ksyn*(v-vth)))

# Presynaptic activation. Fixed variables are evaluated in file order.
s0=gate(v0)
s1=gate(v1)
s2=gate(v2)
s3=gate(v3)
s4=gate(v4)
s5=gate(v5)
s6=gate(v6)
s7=gate(v7)
s8=gate(v8)
s9=gate(v9)
s10=gate(v10)
s11=gate(v11)
s12=gate(v12)
s13=gate(v13)
s14=gate(v14)
s15=gate(v15)
s16=gate(v16)

# Expanded chemical and gap-junction inputs by postsynaptic cell.
e0=s3
i0=0
j0=0
e1=s3
i1=0
j1=(v1-v2)
e2=s0
i2=0
j2=(v2-v1)+(v2-v9)
e3=s2
i3=0
j3=0
e4=s0+s2+s3+s7+s8+s9+s10
i4=0
j4=(v4-v5)+(v4-v6)
e5=s0+s2+s3+s9
i5=s4
j5=(v5-v4)+(v5-v6)+(v5-v9)
e6=s1+s2+s3+s8+s10
i6=0
j6=(v6-v4)+(v6-v5)+(v6-v10)
e7=s10
i7=s5
j7=(v7-v8)
e8=0
i8=s6
j8=(v8-v7)
e9=s7+s10
i9=s5
j9=(v9-v2)+(v9-v5)
e10=0
i10=s6
j10=(v10-v6)
e11=s0+s2+s3
i11=s4
j11=0
e12=s1+s2+s3
i12=s4
j12=0
e13=s1+s3
i13=s4
j13=0
e14=s7+s9
i14=s5
j14=0
e15=s7+s8+s9+s10
i15=s5+s6
j15=0
e16=s8+s10
i16=s6
j16=0

# Voltage and recovery equations (34 dynamical variables).
v0'=(gmem*memb(v0)-w0-gse*e0*(v0-ere)-gsi*i0*(v0-eri)-ggap*j0+iava+iavb)/cap
w0'=(winf(v0)-w0)/tauw
v1'=(gmem*memb(v1)-w1-gse*e1*(v1-ere)-gsi*i1*(v1-eri)-ggap*j1+iava+iavb)/cap
w1'=(winf(v1)-w1)/tauw
v2'=(gmem*memb(v2)-w2-gse*e2*(v2-ere)-gsi*i2*(v2-eri)-ggap*j2+iava)/cap
w2'=(winf(v2)-w2)/tauw
v3'=(gmem*memb(v3)-w3-gse*e3*(v3-ere)-gsi*i3*(v3-eri)-ggap*j3+iavb)/cap
w3'=(winf(v3)-w3)/tauw
v4'=(gmem*memb(v4)-w4-gse*e4*(v4-ere)-gsi*i4*(v4-eri)-ggap*j4+0)/cap
w4'=(winf(v4)-w4)/tauw
v5'=(gmem*memb(v5)-w5-gse*e5*(v5-ere)-gsi*i5*(v5-eri)-ggap*j5+0)/cap
w5'=(winf(v5)-w5)/tauw
v6'=(gmem*memb(v6)-w6-gse*e6*(v6-ere)-gsi*i6*(v6-eri)-ggap*j6+0)/cap
w6'=(winf(v6)-w6)/tauw
v7'=(gmem*memb(v7)-w7-gse*e7*(v7-ere)-gsi*i7*(v7-eri)-ggap*j7+iavb)/cap
w7'=(winf(v7)-w7)/tauw
v8'=(gmem*memb(v8)-w8-gse*e8*(v8-ere)-gsi*i8*(v8-eri)-ggap*j8+iavb)/cap
w8'=(winf(v8)-w8)/tauw
v9'=(gmem*memb(v9)-w9-gse*e9*(v9-ere)-gsi*i9*(v9-eri)-ggap*j9+iava)/cap
w9'=(winf(v9)-w9)/tauw
v10'=(gmem*memb(v10)-w10-gse*e10*(v10-ere)-gsi*i10*(v10-eri)-ggap*j10+iava)/cap
w10'=(winf(v10)-w10)/tauw
v11'=(gmem*memb(v11)-w11-gse*e11*(v11-ere)-gsi*i11*(v11-eri)-ggap*j11+0)/cap
w11'=(winf(v11)-w11)/tauw
v12'=(gmem*memb(v12)-w12-gse*e12*(v12-ere)-gsi*i12*(v12-eri)-ggap*j12+0)/cap
w12'=(winf(v12)-w12)/tauw
v13'=(gmem*memb(v13)-w13-gse*e13*(v13-ere)-gsi*i13*(v13-eri)-ggap*j13+0)/cap
w13'=(winf(v13)-w13)/tauw
v14'=(gmem*memb(v14)-w14-gse*e14*(v14-ere)-gsi*i14*(v14-eri)-ggap*j14+0)/cap
w14'=(winf(v14)-w14)/tauw
v15'=(gmem*memb(v15)-w15-gse*e15*(v15-ere)-gsi*i15*(v15-eri)-ggap*j15+0)/cap
w15'=(winf(v15)-w15)/tauw
v16'=(gmem*memb(v16)-w16-gse*e16*(v16-ere)-gsi*i16*(v16-eri)-ggap*j16+0)/cap
w16'=(winf(v16)-w16)/tauw

# Rest initial condition.
init v0=-70,v1=-70,v2=-70,v3=-70,v4=-70,v5=-70
init v6=-70,v7=-70,v8=-70,v9=-70,v10=-70,v11=-70
init v12=-70,v13=-70,v14=-70,v15=-70,v16=-70
init w0=0,w1=0,w2=0,w3=0,w4=0,w5=0,w6=0,w7=0,w8=0
init w9=0,w10=0,w11=0,w12=0,w13=0,w14=0,w15=0,w16=0

# Useful readouts: mean command targets and mean muscle voltages.
aux avam=(v0+v1+v2+v9+v10)/5
aux avbm=(v0+v1+v3+v7+v8)/5
aux dorsm=(v11+v12+v13)/3
aux ventm=(v14+v15+v16)/3

# Stiff time integration and practical AUTO defaults.
@ meth=cvode,dt=1,total=20000,nout=10,tol=1e-8,atol=1e-8
@ maxstor=200000,bound=100000,bell=0
@ autovar=v4,parmin=0,parmax=6,autoxmin=0,autoxmax=6
@ autoymin=-80,autoymax=-20,ds=0.01,dsmax=0.05,nmax=10000,npr=20
done
